  }
  $(".snp-sku").addEventListener("click", copySku);
  $(".snp-sku").addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); copySku(); } });

  renderThumbs();
  render();
  }
  function wait() { if (window.gsap) boot(); else setTimeout(wait, 50); }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", wait); else wait();
})();
