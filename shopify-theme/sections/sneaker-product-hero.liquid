  var up = function () { if (!holding) return; holding = false; gsap.to(loupe, { autoAlpha: 0, scale: 0.7, duration: reduced() ? 0 : 0.2 }); };
  stage.addEventListener("pointerup", up); stage.addEventListener("pointercancel", up);
  stage.addEventListener("click", function () { if (lastPointer === "touch") openViewer(0); });

  var viewerEl = $(".snp-viewer"), frame = $(".snp-frame", viewerEl), frameView = $(".snp-frame .snp-view", viewerEl), rail = $(".snp-rail", viewerEl);
  document.body.appendChild(viewerEl);
  ["--color-foreground", "--color-background", "--color-muted-foreground"].forEach(function (k) { viewerEl.style.setProperty(k, root.style.getPropertyValue(k)); });
  function renderViewer() {
    var vs = views(), vw = vs[viewer];
