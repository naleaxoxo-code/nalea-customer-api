      var lines = boards.filter(function (bd) { return bd.dataset.type !== "photo"; })
        .map(function (bd) { var i = bd.querySelector(".snp-field"); return i && i.value.trim(); }).filter(Boolean).slice(0, 2);
      var ts = live.querySelectorAll(".snp-live-t");
      ts[0].textContent = lines[0] || "";
      var second = ts[1];
      if (lines[1]) { if (!second) { second = document.createElement("span"); second.className = "snp-live-t"; ts[0].after(second); } second.textContent = lines[1]; }
      else if (second) second.remove();
      var on = lines.length > 0;
      if (on !== liveOn) { liveOn = on; gsap.to(live, { autoAlpha: on ? 1 : 0, y: on ? 0 : 8, duration: reduced() ? 0 : 0.35, ease: "power2.out" }); }
    }
    boards.forEach(function (bd) { var i = bd.querySelector(".snp-field"); if (i) i.addEventListener("input", livePreview); });

    box.addEventListener("submit", function (e) {
      e.preventDefault();
      var firstBad = null;
      boards.forEach(function (bd) {
        var inp = bd.querySelector(".snp-field, input[type=file]");
        var empty = inp.type === "file" ? !(inp.files && inp.files[0]) : !inp.value.trim();
        var bad = bd.dataset.req === "true" && empty; bd.dataset.bad = String(bad);
        if (bad && !firstBad) firstBad = bd;
      });
      if (firstBad) { firstBad.scrollIntoView({ behavior: "smooth", block: "center" }); var fi = firstBad.querySelector(".snp-field, input"); if (fi) fi.focus(); return; }
      goBtn.disabled = true; goBtn.textContent = "Uploading\u2026";
      var props = {}, ups = [];
      boards.forEach(function (bd) {
        var key = bd.dataset.key, inp = bd.querySelector(".snp-field, input[type=file]");
        if (inp.type === "file") {
          var fl = inp.files && inp.files[0]; if (!fl) return;
          var fd = new FormData(); fd.append("photo", fl);
          ups.push(fetch("/apps/nalea/personalization/photo" + location.search, { method: "POST", body: fd })
            .then(function (r) { return r.json(); })
            .then(function (d) { if (d && d.success && d.url) props[key] = d.url; else throw new Error("upload"); }));
        } else if (inp.value.trim()) props[key] = inp.value.trim();
      });
      Promise.all(ups).then(function () {
        goBtn.textContent = "Adding\u2026";
        return cartAdd(props);
      }).then(function (ok) {
        goBtn.disabled = false; goBtn.textContent = "ADD TO CART";
        if (ok) closeSheet();
      }).catch(function () {
        goBtn.disabled = false; goBtn.textContent = "ADD TO CART";
        showToast("Photo upload failed, please try again");
      });
    });
  }

  function showToast(note) {
