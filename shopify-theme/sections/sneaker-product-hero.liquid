{%- liquid
  assign p = product
  if p == blank
    assign p = all_products[section.settings.product]
  endif
-%}

{%- if p != blank -%}
{%- liquid
  assign rt_title = p.title | downcase
  assign rt_type = p.type | downcase
  assign rt = 'ok'
  if p.tags contains 'non-returnable' or p.tags contains 'final-sale' or p.tags contains 'final sale'
    assign rt = 'final'
  elsif p.gift_card?
    assign rt = 'gift'
  elsif rt_title contains 'personali' or rt_title contains 'custom' or rt_title contains 'engraved' or rt_title contains 'monogram'
    assign rt = 'personal'
  else
    assign beauty_words = 'beauty,makeup,make-up,cosmetic,nail,lip gloss,lip liner,lip pencil,lip balm,lipstick,eyelash,lash adhesive,eyebrow,brow ,skin care,skincare,facial,sheet mask,face mask,serum,body lotion,fragrance,perfume,razor,dental,floss,hair tie,scrunchie,bonnet,makeup brush,hairbrush,hair brush,thong,bralette, bra ,bra set,underwear'
    assign beauty_list = beauty_words | split: ','
    for w in beauty_list
      if rt_type contains w or rt_title contains w
        assign rt = 'hygiene'
        break
      endif
    endfor
  endif
  if p.tags contains 'returnable'
    assign rt = 'ok'
  endif
  assign policy_url = shop.refund_policy.url | default: '/policies/refund-policy'
  assign board_count = 0
  for block in section.blocks
    if block.type == 'personalization_board'
      assign board_count = board_count | plus: 1
    endif
  endfor
  assign ship = p.metafields.custom.shipping_timeline.value
-%}
<section
  id="snp-{{ section.id }}"
  class="snp-root"
  style="min-height:{{ section.settings.height }};--snp-like:{{ section.settings.like_color }};--color-foreground:{{ section.settings.foreground }};--color-background:{{ section.settings.background }};--color-muted-foreground:{{ section.settings.muted }};"
  aria-label="{{ p.title | escape }}"
>
{%- if board_count > 0 -%}<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap">{%- endif -%}
<style>
#snp-{{ section.id }}.snp-root{position:relative;display:flex;flex-direction:column;width:100%;container-type:inline-size;overflow:hidden;isolation:isolate;color:var(--color-foreground);background:color-mix(in oklab,var(--color-foreground) 4%,var(--color-background));font-family:inherit;-webkit-font-smoothing:antialiased}
:where(.snp-root) :where(*,*::before,*::after){box-sizing:border-box}
:where(.snp-root) :where(button){font:inherit;color:inherit;background:none;border:0;padding:0;margin:0;cursor:pointer;letter-spacing:inherit;text-transform:none;min-height:0;box-shadow:none}
.snp-root img{max-width:none;display:block}
.snp-bg{position:absolute;inset:0;z-index:-1;opacity:0;transition:opacity .8s ease;pointer-events:none;background:radial-gradient(var(--snp-gs,48% 62%) at calc(50% + var(--mx,0%)) calc(var(--snp-gy,52%) + var(--my,0%)),color-mix(in oklab,var(--t) 42%,transparent),transparent 72%),color-mix(in oklab,var(--t) 15%,color-mix(in oklab,var(--color-foreground) 4%,var(--color-background)))}
.snp-bg[data-on="true"]{opacity:1}
.snp-body{position:relative;flex:1;display:grid;grid-template-columns:20cqw minmax(0,1fr) 17cqw;column-gap:3cqw;align-items:start;align-content:center;padding:4cqw 9cqw 4cqw 7.3cqw;overflow:hidden}
.snp-info{align-self:start;position:relative;z-index:1}
.snp-eyebrow{margin:0;font-size:max(12px,1.5cqw);color:var(--color-muted-foreground)}
.snp-title{margin:2cqw 0 0;font-size:max(22px,2.4cqw);line-height:1.18;font-weight:600;letter-spacing:-.01em;max-width:17cqw;text-wrap:balance;color:inherit}
.snp-desc{margin:3.6cqw 0 0;max-width:19cqw;font-size:max(11px,1.05cqw);line-height:1.45;font-style:italic;color:var(--color-muted-foreground)}
.snp-desc{max-height:calc(1.45em * var(--snp-lines,7));overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:color-mix(in oklab,var(--color-muted-foreground) 35%,transparent) transparent;padding-right:.8cqw;outline:none;
  --fade:2.2em;-webkit-mask-image:linear-gradient(to bottom,#000 0,#000 100%);mask-image:linear-gradient(to bottom,#000 0,#000 100%);transition:-webkit-mask-image .2s}
.snp-desc[data-fade="bottom"]{-webkit-mask-image:linear-gradient(to bottom,#000 calc(100% - var(--fade)),transparent);mask-image:linear-gradient(to bottom,#000 calc(100% - var(--fade)),transparent)}
.snp-desc[data-fade="both"]{-webkit-mask-image:linear-gradient(to bottom,transparent,#000 var(--fade),#000 calc(100% - var(--fade)),transparent);mask-image:linear-gradient(to bottom,transparent,#000 var(--fade),#000 calc(100% - var(--fade)),transparent)}
.snp-desc[data-fade="top"]{-webkit-mask-image:linear-gradient(to bottom,transparent,#000 var(--fade));mask-image:linear-gradient(to bottom,transparent,#000 var(--fade))}
.snp-desc::-webkit-scrollbar{width:3px}.snp-desc::-webkit-scrollbar-thumb{background:color-mix(in oklab,var(--color-muted-foreground) 35%,transparent);border-radius:3px}
.snp-desc:focus-visible{outline:1px solid color-mix(in oklab,var(--color-foreground) 30%,transparent);outline-offset:6px}
.snp-desc>*{margin:0 0 .7em}.snp-desc>*:last-child{margin-bottom:0}
.snp-desc :is(h1,h2,h3,h4,h5,h6){font-size:1em;font-weight:600;font-style:normal;color:var(--color-foreground);letter-spacing:0;line-height:1.45;margin:1em 0 .3em}
.snp-desc>:first-child{margin-top:0}
.snp-desc :is(strong,b){color:var(--color-foreground);font-weight:600}
.snp-desc :is(ul,ol){padding-left:1.2em}.snp-desc li{margin:.2em 0}
.snp-desc a{color:var(--color-foreground);text-underline-offset:2px}
.snp-desc :is(img,iframe,video,table){display:none}
.snp-desc *{font-size:inherit!important;font-family:inherit!important;color:inherit;background:none!important}
.snp-desc :is(strong,b,h1,h2,h3,h4,h5,h6,a){color:var(--color-foreground)}
.snp-thumbs{display:flex;align-items:center;gap:2.4cqw;margin-top:5cqw}
.snp-thumbset{display:flex;align-items:center;gap:inherit}
.snp-thumb{flex:none;width:4.6cqw;height:3cqw;overflow:hidden;border-radius:4px;outline-offset:3px;transition:transform .25s}
.snp-thumb:hover{transform:translateY(-2px)}
.snp-view{display:block;width:100%;height:100%;background-repeat:no-repeat}
.snp-more{flex:none;width:3cqw;height:3cqw;display:grid;place-items:center;background:var(--color-foreground)!important;color:var(--color-background)!important;font-size:max(10px,1.05cqw);transition:transform .25s}
.snp-more[hidden]{display:none}
.snp-more:hover{transform:scale(1.08)}
.snp-stage{position:relative;align-self:stretch;max-height:42cqw;min-height:26cqw}
.snp-word{position:absolute;left:50%;top:0;translate:-50% -14%;font-size:11cqw;line-height:1;font-weight:800;letter-spacing:-.04em;text-transform:uppercase;white-space:nowrap;color:color-mix(in oklab,var(--t) 34%,transparent);pointer-events:none;user-select:none}
.snp-float{position:absolute;inset:0}
.snp-tilt{position:absolute;inset:0;transform-style:preserve-3d}
.snp-reflects{position:absolute;inset:0;pointer-events:none}
.snp-shoe.snp-reflect{transform:scaleY(-1);transform-origin:50% 88.5%;filter:blur(.6px);-webkit-mask-image:linear-gradient(to bottom,transparent 52%,#000 88%);mask-image:linear-gradient(to bottom,transparent 52%,#000 88%)}
.snp-shoe.snp-sheen{display:block;pointer-events:none;filter:none;background:linear-gradient(100deg,transparent 40%,rgba(255,255,255,.55) 50%,transparent 60%) 130% 0/300% 100% no-repeat;-webkit-mask-size:100% 100%;mask-size:100% 100%;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:center;mask-position:center}
.snp-loupe{position:absolute;left:0;top:0;z-index:3;width:max(130px,15cqw);aspect-ratio:1;border-radius:50%;overflow:hidden;visibility:hidden;opacity:0;pointer-events:none;background:color-mix(in oklab,var(--snp-tint) 18%,var(--color-background));box-shadow:0 0 0 2px var(--color-background),0 18px 44px -12px rgba(0,0,0,.4)}
.snp-loupe>span{position:absolute;inset:0;background-repeat:no-repeat}
.snp-hint{position:absolute;left:3%;bottom:4%;transition:opacity .5s;font-size:max(10px,.85cqw);letter-spacing:.12em;text-transform:uppercase;color:var(--color-muted-foreground);pointer-events:none}
.snp-hint-touch{display:none}
.snp-hint[data-seen="true"]{opacity:0}
@media (pointer:fine){.snp-stage{cursor:zoom-in}}
@media (pointer:coarse){.snp-hint-fine{display:none}.snp-hint-touch{display:inline}}
.snp-shoe{position:absolute;left:50%;top:50%;width:96%;height:auto;aspect-ratio:16/9;object-fit:contain;translate:-50% -58%;filter:drop-shadow(0 1.6cqw 1.4cqw rgba(0,0,0,.12))}
.snp-floor{position:absolute;left:18%;right:14%;top:50%;height:4cqw;translate:0 6.6cqw;border-radius:50%;background:radial-gradient(closest-side,rgba(0,0,0,.22),transparent);filter:blur(4px)}
.snp-buy{align-self:start;font-size:max(11px,1.25cqw);position:relative;z-index:1}
.snp-label{display:block;font-size:max(12px,1.45cqw);color:var(--color-muted-foreground);letter-spacing:.02em}
.snp-sizes{display:flex;flex-wrap:wrap;gap:1.6cqw;margin-top:1.5cqw}
.snp-size{width:max(32px,3.1cqw);height:max(32px,3.1cqw);border-radius:50%!important;display:grid;place-items:center;border:1.5px solid var(--color-foreground)!important;font-size:max(11px,1.15cqw)!important;font-weight:500;transition:background .25s,color .25s,transform .2s}
.snp-size:not(:disabled):hover{transform:scale(1.07)}
.snp-size[aria-pressed="true"]{background:var(--color-foreground)!important;color:var(--color-background)!important}
.snp-size:disabled{opacity:.35;cursor:not-allowed;border-width:1px!important}
.snp-stock{display:flex;align-items:center;gap:.6cqw;margin-top:1.2cqw;font-size:max(10px,.95cqw);color:var(--color-muted-foreground)}
.snp-stock::before{content:"";width:max(6px,.55cqw);height:max(6px,.55cqw);border-radius:50%;background:#22c55e}
.snp-stock[data-tone="low"]{color:#f97316}
.snp-stock[data-tone="low"]::before{background:#f97316}
.snp-stock[data-tone="out"]::before{background:var(--color-muted-foreground)}
.snp-row{display:flex;align-items:center;justify-content:space-between;margin-top:3cqw}
.snp-rating{display:flex;align-items:center;gap:.6cqw}
.snp-stars{position:relative;display:inline-block;color:var(--color-muted-foreground)}
.snp-starrow{display:flex;gap:.35cqw}
.snp-starfill{position:absolute;inset:0;color:var(--color-foreground);transition:clip-path .6s cubic-bezier(.2,.8,.2,1)}
.snp-stars svg{width:max(11px,1.25cqw);height:max(11px,1.25cqw)}
.snp-count{font-size:max(10px,1cqw);color:var(--color-muted-foreground);font-variant-numeric:tabular-nums}
.snp-price{display:inline-block;font-weight:600;font-size:max(13px,1.4cqw);font-variant-numeric:tabular-nums}
.snp-sku{position:relative;display:flex;align-items:center;justify-content:space-between;margin-top:1.4cqw;cursor:pointer;user-select:none;outline-offset:4px}
.snp-sku[hidden]{display:none}
.snp-sku-code{display:inline-flex;align-items:center;gap:.7cqw;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:max(11px,1.05cqw);letter-spacing:.04em;color:var(--color-foreground);transition:opacity .2s}
.snp-sku:hover .snp-sku-code{opacity:.8}
.snp-bars{display:flex;align-items:flex-end;gap:1.5px;height:max(12px,1.1cqw)}
.snp-bars i{display:block;background:var(--color-muted-foreground);border-radius:.5px}
.snp-sku-ic{width:max(12px,1cqw);height:max(12px,1cqw);flex:none;color:var(--color-muted-foreground);transition:color .2s}
.snp-sku[data-copied="true"] .snp-sku-ic{color:#22c55e}
.snp-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.snp-colour{margin-top:3.1cqw}
.snp-swatches{display:flex;flex-wrap:wrap;gap:2.4cqw;margin-top:3.2cqw}
.snp-swatch{width:max(30px,3.1cqw);height:max(30px,3.1cqw);border-radius:50%!important;background:var(--sw)!important;box-shadow:inset 0 0 0 1px color-mix(in oklab,var(--color-foreground) 22%,transparent)!important;transition:box-shadow .3s,transform .2s}
.snp-swatch:hover{transform:scale(1.08)}
.snp-swatch[aria-pressed="true"]{box-shadow:inset 0 0 0 max(3px,.3cqw) var(--sw),inset 0 0 0 max(6px,.65cqw) var(--color-background),inset 0 0 0 20cqw var(--sw)!important}
.snp-actions{position:relative;display:flex;align-items:center;gap:3.6cqw;margin-top:4.2cqw}
.snp-cta{position:relative;display:grid;place-items:center;min-width:max(150px,11.6cqw);overflow:hidden;height:max(40px,4.4cqw);padding:0 2cqw!important;background:var(--color-foreground)!important;color:var(--color-background)!important;font-weight:600;font-size:max(11px,1.15cqw)!important;letter-spacing:.02em!important;white-space:nowrap;border-radius:0!important;transition:transform .15s,background .35s}
.snp-cta:active{transform:scale(.96)}
.snp-cta>span{grid-area:1/1;display:inline-flex;align-items:center;gap:.6em;transition:opacity .25s,transform .4s cubic-bezier(.2,.8,.2,1)}
.snp-cta-busy,.snp-cta-done{opacity:0;transform:translateY(70%)}
.snp-cta[data-state="busy"] .snp-cta-idle,.snp-cta[data-state="done"] .snp-cta-idle{opacity:0;transform:translateY(-70%)}
.snp-cta[data-state="busy"] .snp-cta-busy,.snp-cta[data-state="done"] .snp-cta-done{opacity:1;transform:none}
.snp-cta[data-state="done"]{background:#15803d!important;color:#fff!important}
.snp-cta-busy i{width:1.15em;height:1.15em;border-radius:50%;border:2px solid currentColor;border-right-color:transparent;animation:snp-spin .7s linear infinite}
@keyframes snp-spin{to{transform:rotate(360deg)}}
.snp-cta-done svg{width:1.25em;height:1.25em;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:24;stroke-dashoffset:24;transition:stroke-dashoffset .45s .12s ease}
.snp-cta[data-state="done"] .snp-cta-done svg{stroke-dashoffset:0}
.snp-cta:disabled{opacity:.45;cursor:not-allowed}
.snp-like{position:relative;width:max(24px,2.4cqw);height:max(24px,2.4cqw);display:grid;place-items:center}
.snp-like>svg{width:80%;height:80%;overflow:visible}
.snp-like>svg path{fill:none;stroke:currentColor;stroke-width:1.8;transition:fill .3s,stroke .3s}
.snp-like[aria-pressed="true"]>svg path{fill:var(--snp-like);stroke:var(--snp-like)}
.snp-share{position:relative;width:max(24px,2.4cqw);height:max(24px,2.4cqw);display:grid;place-items:center;transition:transform .2s}
.snp-share:hover{transform:translateY(-2px)}
.snp-share>svg{width:76%;height:76%;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.snp-menu{position:absolute;right:-.4cqw;bottom:calc(100% + 1cqw);z-index:4;min-width:max(190px,15cqw);padding:6px;border-radius:14px;background:var(--color-foreground);color:var(--color-background);box-shadow:0 18px 44px -12px rgba(0,0,0,.45);visibility:hidden;opacity:0}
.snp-menu button{display:flex;align-items:center;gap:10px;width:100%;padding:9px 10px!important;border-radius:9px!important;font-size:max(12px,1cqw)!important;font-weight:500;text-align:left;color:inherit!important;transition:background .15s}
.snp-menu button:hover,.snp-menu button:focus-visible{background:color-mix(in oklab,var(--color-background) 10%,transparent)!important;outline:none}
.snp-menu i{display:grid;place-items:center;width:26px;height:26px;flex:none;border-radius:50%;background:color-mix(in oklab,var(--color-background) 8%,transparent)}
.snp-menu i svg{width:15px;height:15px}
.snp-menu .snp-wa i{background:#25d366;color:#fff}
#snp-{{ section.id }} .snp-like,#snp-{{ section.id }} .snp-share{display:grid!important;place-items:center!important;flex:none!important;width:max(28px,2.6cqw)!important;height:max(28px,2.6cqw)!important;min-width:0!important;min-height:0!important;padding:0!important;margin:0!important;border:0!important;border-radius:50%!important;background:transparent!important;box-shadow:none!important;color:var(--color-foreground)!important;opacity:1!important;visibility:visible!important;overflow:visible!important}
#snp-{{ section.id }} .snp-like>svg,#snp-{{ section.id }} .snp-share>svg{display:block!important;width:80%!important;height:80%!important;opacity:1!important;visibility:visible!important}
#snp-{{ section.id }} .snp-like>svg path{stroke:currentColor!important}
#snp-{{ section.id }} .snp-like[aria-pressed="true"]>svg path{fill:var(--snp-like)!important;stroke:var(--snp-like)!important}
#snp-{{ section.id }} .snp-share>svg{fill:none!important;stroke:currentColor!important}
#snp-{{ section.id }} .snp-like:focus-visible,#snp-{{ section.id }} .snp-share:focus-visible{outline:2px solid var(--color-foreground)!important;outline-offset:3px}
.snp-trust{position:relative;margin-top:2.6cqw;display:flex;flex-direction:column;gap:1cqw}
.snp-trust-btn{display:inline-flex!important;align-items:center!important;gap:.7cqw!important;width:max-content;padding:0!important;background:none!important;border:0!important;box-shadow:none!important;color:var(--color-muted-foreground)!important;font-size:max(11px,1cqw)!important;letter-spacing:.02em!important;text-transform:none!important;cursor:help!important;transition:color .2s}
.snp-trust-btn:hover,.snp-trust-btn:focus-visible{color:var(--color-foreground)!important}
.snp-trust-btn svg{width:max(13px,1.1cqw);height:max(13px,1.1cqw);flex:none;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.snp-trust-btn b{color:var(--color-foreground);font-weight:600}
.snp-trust-btn[data-tone="no"] svg{color:var(--color-foreground)}
.snp-tip a{color:inherit;font-weight:600;text-decoration:underline;text-underline-offset:2px;pointer-events:auto}
.snp-sheet,.snp-sheet *{box-sizing:border-box}
.snp-live{position:absolute;left:50%;top:50%;z-index:2;translate:-50% -40%;width:72%;text-align:center;pointer-events:none;opacity:0;visibility:hidden}
.snp-live-t{display:block;font-family:"Great Vibes","Allura","Brush Script MT",cursive;font-size:clamp(28px,4.6cqw,72px);line-height:1.1;font-weight:400;letter-spacing:.01em;
  background:linear-gradient(100deg,#9a7327 0%,#e8cb82 28%,#fff4cf 46%,#c9a84c 62%,#8b6a00 100%);background-size:220% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 2px 6px rgba(0,0,0,.45));overflow-wrap:anywhere;animation:snp-gold 4s linear infinite}
.snp-live-t+.snp-live-t{font-size:clamp(18px,2.4cqw,38px);margin-top:.2em}
@keyframes snp-gold{to{background-position:-220% 0}}
.snp-live-n{display:inline-block;margin-top:1cqw;padding:.35em .9em;border-radius:999px;background:color-mix(in oklab,var(--color-background) 70%,transparent);color:var(--color-muted-foreground);font-size:max(10px,.8cqw);letter-spacing:.06em}
@media (max-width:760px){.snp-sheet-box{max-height:58vh}}
.snp-sheet{position:fixed;inset:0;z-index:9998;display:flex;align-items:flex-end;justify-content:flex-end;padding:3vh 4vw;color:var(--color-foreground)}
.snp-sheet[hidden]{display:none}
.snp-sheet-scrim{position:absolute;inset:0;background:color-mix(in oklab,var(--color-background) 18%,transparent)!important;border:0!important;padding:0!important;cursor:default}
.snp-sheet-box{position:relative;width:min(420px,100%);max-height:88vh;overflow:auto;overscroll-behavior:contain;border-radius:18px;background:color-mix(in oklab,var(--color-foreground) 6%,var(--color-background));box-shadow:0 30px 80px -20px rgba(0,0,0,.6),0 0 0 1px color-mix(in oklab,var(--color-foreground) 12%,transparent);padding:22px}
.snp-sheet-hd{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:6px}
.snp-sheet-hd h3{margin:0;font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--color-foreground)}
.snp-sheet-sub{margin:0 0 16px;font-size:13px;color:var(--color-muted-foreground)}
.snp-sheet-x{width:32px!important;height:32px!important;border-radius:50%!important;display:grid!important;place-items:center!important;background:transparent!important;border:0!important;color:var(--color-foreground)!important;padding:0!important}
.snp-sheet-x svg{width:16px;height:16px}
.snp-board{margin-bottom:16px}
.snp-board-t{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--color-muted-foreground)}
.snp-board-t em{font-style:normal;color:var(--snp-like)}
.snp-field{display:block;width:100%;border-radius:10px;border:1px solid color-mix(in oklab,var(--color-foreground) 18%,transparent)!important;background:color-mix(in oklab,var(--color-background) 70%,transparent)!important;color:var(--color-foreground)!important;padding:11px 13px!important;font:inherit;font-size:15px!important;outline:none;box-shadow:none!important;transition:border-color .2s}
.snp-field:focus{border-color:var(--color-foreground)!important}
textarea.snp-field{min-height:96px;resize:vertical}
.snp-board-l{display:block;margin:0 0 6px;font-size:13px;color:var(--color-foreground)}
.snp-board-h{margin-top:6px;font-size:12px;color:var(--color-muted-foreground)}
.snp-count-c{margin-top:4px;text-align:right;font-size:11px;color:var(--color-muted-foreground);font-variant-numeric:tabular-nums}
.snp-drop{position:relative;display:flex;align-items:center;gap:12px;padding:14px;border-radius:12px;border:1px dashed color-mix(in oklab,var(--color-foreground) 28%,transparent);cursor:pointer;transition:border-color .2s,background .2s}
.snp-drop:hover,.snp-drop[data-over="true"]{border-color:var(--color-foreground);background:color-mix(in oklab,var(--color-foreground) 5%,transparent)}
.snp-drop input{position:absolute;inset:0;opacity:0;cursor:pointer}
.snp-drop svg{width:22px;height:22px;flex:none;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.snp-drop b{display:block;font-size:14px;font-weight:600}.snp-drop span{display:block;font-size:12px;color:var(--color-muted-foreground)}
.snp-drop img{width:52px;height:52px;object-fit:cover;border-radius:8px;flex:none;margin-left:auto}
.snp-board[data-bad="true"] .snp-field,.snp-board[data-bad="true"] .snp-drop{border-color:#f87171!important}
.snp-board-e{display:none;margin-top:6px;font-size:12px;color:#fca5a5}.snp-board[data-bad="true"] .snp-board-e{display:block}
.snp-sheet-go{width:100%;height:48px;margin-top:6px;background:var(--color-foreground)!important;color:var(--color-background)!important;border:0!important;border-radius:0!important;font-weight:600!important;font-size:13px!important;letter-spacing:.06em!important;cursor:pointer}
.snp-sheet-go:disabled{opacity:.55;cursor:wait}
@media (max-width:760px){.snp-sheet{padding:0;justify-content:center}.snp-sheet-box{width:100%;max-height:86vh;border-radius:18px 18px 0 0;padding:20px 18px calc(20px + env(safe-area-inset-bottom))}}
.snp-pay{display:flex;flex-wrap:wrap;gap:.6cqw}
.snp-pay span{display:grid;place-items:center;height:max(20px,1.8cqw);min-width:max(32px,2.9cqw);padding:0 .45cqw;border-radius:4px;background:#fff;font:700 max(9px,.75cqw)/1 system-ui,-apple-system,"Segoe UI",sans-serif;letter-spacing:0;white-space:nowrap}
.snp-pay svg{height:62%;width:auto;display:block}
.snp-pay .snp-ap{background:#000;color:#fff}
.snp-tip{position:absolute;left:0;bottom:calc(100% + 1cqw);z-index:4;max-width:max(230px,19cqw);padding:.8cqw 1.2cqw;border-radius:12px;background:var(--color-foreground);color:var(--color-background);font-size:max(11px,.95cqw);line-height:1.4;font-weight:500;box-shadow:0 18px 44px -12px rgba(0,0,0,.45);visibility:hidden;opacity:0;pointer-events:none}
.snp-burst{position:absolute;left:50%;top:50%;width:0;height:0;pointer-events:none}
.snp-burst svg{position:absolute;left:-6px;top:-6px;width:12px;height:12px;color:var(--snp-like);opacity:0}
.snp-pill{position:absolute;right:-.4cqw;bottom:calc(100% + 1cqw);padding:.6cqw 1.2cqw;border-radius:999px;white-space:nowrap;background:var(--color-foreground);color:var(--color-background);font-size:max(10px,.95cqw);font-weight:500;visibility:hidden;opacity:0;pointer-events:none}
.snp-pill b{color:var(--snp-like);font-weight:700}
.snp-toast{position:absolute;left:50%;bottom:6.6cqw;translate:-50% 0;display:flex;align-items:center;gap:1cqw;padding:1.1cqw 2.2cqw;border-radius:999px;background:var(--color-background);font-size:max(11px,1cqw);font-weight:500;white-space:nowrap;box-shadow:0 6px 24px color-mix(in oklab,var(--color-foreground) 8%,transparent);visibility:hidden;opacity:0;z-index:2}
.snp-toast i{width:max(9px,1cqw);height:max(9px,1cqw);border-radius:50%;background:#22c55e;box-shadow:0 0 0 3px color-mix(in oklab,#22c55e 25%,transparent)}
.snp-toast small{font-size:inherit;color:var(--color-muted-foreground);font-weight:400}
.snp-viewer{position:fixed;inset:0;z-index:9999;display:grid;grid-template-columns:minmax(0,1fr);place-items:center;padding:24px;color:var(--color-foreground)}
.snp-viewer[hidden]{display:none}
.snp-scrim{position:absolute;inset:0;background:color-mix(in oklab,var(--color-background) 72%,transparent)!important;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);cursor:zoom-out}
.snp-box{position:relative;width:min(880px,100%);display:flex;flex-direction:column;gap:14px}
.snp-frame{position:relative;aspect-ratio:16/10;max-height:72vh;width:100%;border-radius:14px;overflow:hidden;cursor:zoom-in;background:radial-gradient(60% 70% at 50% 55%,color-mix(in oklab,var(--snp-tint) 38%,transparent),transparent 75%),color-mix(in oklab,var(--snp-tint) 14%,var(--color-background));box-shadow:0 30px 80px -20px rgba(0,0,0,.35)}
.snp-frame .snp-view{position:absolute;inset:0;width:auto;height:auto;transition:transform .45s cubic-bezier(.2,.8,.2,1)}
.snp-frame[data-zoom="true"]{cursor:zoom-out}
.snp-vbar{display:flex;align-items:center;gap:12px;font-size:14px}
.snp-vbar strong{font-weight:600}
.snp-vbar span{color:var(--color-muted-foreground);font-variant-numeric:tabular-nums}
.snp-vbtn{width:40px;height:40px;border-radius:50%!important;display:grid;place-items:center;background:var(--color-background)!important;color:var(--color-foreground)!important;box-shadow:0 0 0 1px color-mix(in oklab,var(--color-foreground) 14%,transparent)!important;transition:transform .2s}
.snp-vbtn:hover{transform:scale(1.08)}
.snp-vbtn svg{width:18px;height:18px}
.snp-nav-l,.snp-nav-r{position:absolute;top:50%;translate:0 -50%}
.snp-nav-l{left:14px}.snp-nav-r{right:14px}
.snp-close{margin-left:auto}
.snp-rail{display:flex;gap:8px;overflow-x:auto;padding:2px}
.snp-rail button{flex:none;width:76px;height:48px;border-radius:8px!important;overflow:hidden;opacity:.55;transition:opacity .2s;background:color-mix(in oklab,var(--snp-tint) 12%,var(--color-background))!important}
.snp-rail button[aria-current="true"]{opacity:1;box-shadow:0 0 0 2px var(--color-foreground)!important}
@container (max-width:760px){
  .snp-body{grid-template-columns:1fr;grid-template-rows:auto auto auto;padding:24px 20px 72px;row-gap:8px;align-items:start}
  .snp-desc{max-width:none;margin-top:12px;--snp-lines:8}
  .snp-thumbs{margin-top:16px;gap:16px}
  .snp-thumb{width:56px;height:36px}
  .snp-more{width:36px;height:36px}
  .snp-stage{order:-1;min-height:60cqw}
  .snp-word{font-size:20cqw;top:0}
  .snp-info{display:contents}
  .snp-eyebrow{order:-3}
  .snp-title{order:-2;margin-top:4px;max-width:none}
  .snp-desc,.snp-thumbs{order:2}
  .snp-floor{height:9cqw;translate:0 15cqw}
  .snp-buy{order:1}
  .snp-sizes{gap:10px;margin-top:10px}
  .snp-row,.snp-colour{margin-top:18px}
  .snp-sku{margin-top:8px}
  .snp-sku-code{gap:8px}
  .snp-rating{gap:6px}
  .snp-swatches{margin-top:12px;gap:16px}
  .snp-actions{margin-top:22px;gap:20px}
  .snp-trust{margin-top:18px;gap:8px}
  .snp-pay{gap:6px}
  .snp-cta{flex:1}
  .snp-stock{margin-top:8px;gap:6px}
  .snp-hint{bottom:2%}
  .snp-pill{padding:6px 10px;bottom:calc(100% + 8px)}
  .snp-toast{left:50%;bottom:20px;padding:10px 18px;gap:8px}
  .snp-bg{--snp-gy:22%;--snp-gs:85% 26%}
}
@media (max-width:760px){.snp-viewer{padding:12px}.snp-rail button{width:60px;height:40px}.snp-nav-l{left:8px}.snp-nav-r{right:8px}.snp-vbtn{width:36px;height:36px}}
@media (prefers-reduced-motion: reduce){.snp-root *,.snp-viewer *{transition:none!important;animation:none!important}}
</style>

  <div class="snp-bgs"></div>
  <div class="snp-body">
    <div class="snp-info">
      <p class="snp-eyebrow">{{ section.settings.eyebrow | default: p.type | default: p.vendor | escape }}</p>
      <h2 class="snp-title">{{ p.title | escape }}</h2>
      <div class="snp-desc" tabindex="0" role="region" aria-label="Product description" data-fade="none">{{ p.description }}</div>
      <div class="snp-thumbs"><span class="snp-thumbset"></span><button type="button" class="snp-more" hidden></button></div>
    </div>

    <div class="snp-stage">
      <span class="snp-floor" aria-hidden="true"></span>
      <div class="snp-reflects" aria-hidden="true"></div>
      <div class="snp-float"><div class="snp-tilt"><span class="snp-shoe snp-sheen" aria-hidden="true"></span></div></div>
      <span class="snp-loupe" aria-hidden="true"><span></span></span>
      <div class="snp-live" aria-hidden="true"><span class="snp-live-t"></span><span class="snp-live-n">Preview only. Final placement and lettering are crafted by hand.</span></div>
      <span class="snp-hint" data-seen="false" aria-hidden="true"><span class="snp-hint-fine">Hold to zoom</span><span class="snp-hint-touch">Tap to view</span></span>
    </div>

    <div class="snp-buy">
      <div class="snp-size-wrap">
        <span class="snp-label">SIZE</span>
        <div class="snp-sizes" role="group" aria-label="Size"></div>
      </div>
      <span class="snp-stock" data-tone="ok" aria-live="polite"></span>
      <div class="snp-row snp-review-row">
        <span class="snp-label">REVIEWS</span>
        <span class="snp-rating"><span class="snp-stars" role="img"></span><span class="snp-count" aria-label="reviews"></span></span>
      </div>
      <div class="snp-row" aria-live="polite">
        <span class="snp-label">PRICE</span>
        <span class="snp-price"></span>
      </div>
      <div class="snp-sku" role="button" tabindex="0" title="Click to copy" data-copied="false" hidden>
        <span class="snp-label">SKU</span>
        <span class="snp-sku-code"><span class="snp-bars" aria-hidden="true"></span><span class="snp-sku-val"></span><svg class="snp-sku-ic" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2"/><path d="M13 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/></svg></span>
        <span class="snp-sr snp-sku-live" role="status"></span>
      </div>
      <div class="snp-colour-wrap">
        <span class="snp-label snp-colour">COLOUR</span>
        <div class="snp-swatches" role="group" aria-label="Colour"></div>
      </div>
      <div class="snp-actions">
        <button type="button" class="snp-cta" data-state="idle" aria-live="polite">
          <span class="snp-cta-idle">ADD TO CART</span>
          <span class="snp-cta-busy" aria-hidden="true"><i></i></span>
          <span class="snp-cta-done"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"/></svg>ADDED</span>
        </button>
        <button type="button" class="snp-like" aria-pressed="false" aria-label="Save to favourites">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path class="snp-heart"/></svg>
          <span class="snp-burst" aria-hidden="true"></span>
        </button>
        <button type="button" class="snp-share" aria-label="Share this" aria-haspopup="menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3M7.5 7.5 12 3l4.5 4.5M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg>
        </button>
        <div class="snp-menu" role="menu" aria-label="Share this"></div>
        <span class="nxs" aria-hidden="true" style="display:none"></span>
        <span class="snp-pill" role="status" aria-live="polite"></span>
      </div>
      <div class="snp-trust">
        <button type="button" class="snp-trust-btn" aria-describedby="snp-tip-{{ section.id }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>
          <span><b>100% Secure Checkout</b> · {{ section.settings.pay_line | escape }}</span>
        </button>
        <div class="snp-pay" aria-label="Accepted payment methods" role="list">
          <span role="listitem" aria-label="Visa" style="color:#1a1f71;font-style:italic;font-weight:900;letter-spacing:.02em">VISA</span>
          <span role="listitem" aria-label="Mastercard"><svg viewBox="0 0 38 24" aria-hidden="true"><circle cx="14" cy="12" r="9" fill="#eb001b"/><circle cx="24" cy="12" r="9" fill="#f79e1b"/><path d="M19 4.6a9 9 0 0 1 0 14.8 9 9 0 0 1 0-14.8z" fill="#ff5f00"/></svg></span>
          <span role="listitem" aria-label="Apple Pay" class="snp-ap"><svg viewBox="0 0 48 20" aria-hidden="true"><path fill="#fff" d="M8.6 4.3c.5-.6.9-1.5.8-2.3-.8 0-1.7.5-2.2 1.1-.5.5-.9 1.4-.8 2.2.9.1 1.7-.4 2.2-1zm.8 1.2c-1.2-.1-2.2.7-2.8.7-.6 0-1.4-.6-2.4-.6-1.2 0-2.4.7-3 1.9-1.3 2.2-.3 5.5.9 7.3.6.9 1.3 1.8 2.3 1.8.9 0 1.2-.6 2.3-.6s1.4.6 2.3.6c1 0 1.6-.9 2.2-1.8.7-1 1-2 1-2.1 0 0-1.9-.7-1.9-2.9 0-1.8 1.5-2.7 1.6-2.7-.9-1.3-2.2-1.4-2.5-1.6z"/><text x="15" y="15" fill="#fff" font-family="system-ui,-apple-system,sans-serif" font-size="12.5" font-weight="600">Pay</text></svg></span>
          <span role="listitem" aria-label="Google Pay"><svg viewBox="0 0 50 20" aria-hidden="true"><text x="0" y="15" font-family="system-ui,Arial,sans-serif" font-size="14" font-weight="700"><tspan fill="#4285f4">G</tspan><tspan fill="#5f6368" dx="2">Pay</tspan></text></svg></span>
          <span role="listitem" aria-label="Ozow" style="color:#00c8a0;font-weight:800;text-transform:lowercase;letter-spacing:.01em">ozow</span>
          <span role="listitem" aria-label="Yoco" style="color:#000;font-weight:800;text-transform:lowercase">yoco</span>
        </div>
        <span class="snp-tip" id="snp-tip-{{ section.id }}" role="tooltip">{{ section.settings.pay_tip | escape }}</span>
        {%- if ship != blank -%}
        {%- liquid
          case ship
            when 'same_day'
              assign ship_line = '<b>Fast delivery</b> · same or next day'
            when '7_days'
              assign ship_line = '<b>Ships in 5–7 business days</b>'
            when '14_days'
              assign ship_line = '<b>Made for you</b> · ships in 10–14 business days'
          endcase
        -%}
        {%- if ship_line != blank -%}
        <button type="button" class="snp-trust-btn" data-ship="{{ ship }}" aria-describedby="snp-stip-{{ section.id }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg>
          <span>{{ ship_line }}</span>
        </button>
        <span class="snp-tip" id="snp-stip-{{ section.id }}" role="tooltip">{% case ship %}{% when 'same_day' %}Ready to ship. Order before 12:00 for same-day dispatch, delivered same or next day.{% when '7_days' %}Carefully prepared and dispatched with love within 5–7 business days.{% when '14_days' %}Handcrafted and personalised just for you, ready to ship in 10–14 business days. Worth every moment.{% endcase %}</span>
        {%- endif -%}
        {%- endif -%}
        {%- if section.settings.show_returns -%}
        <button type="button" class="snp-trust-btn snp-ret" data-rt="{{ rt }}" data-tone="{% if rt == 'ok' %}ok{% else %}no{% endif %}" aria-describedby="snp-rtip-{{ section.id }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.7"/><path d="M4 4v4h4"/></svg>
          <span class="snp-ret-text"></span>
        </button>
        <span class="snp-tip snp-rtip" id="snp-rtip-{{ section.id }}" role="tooltip"><span class="snp-rtip-text"></span> <a href="{{ policy_url }}" target="_blank" rel="noopener">Read the full policy</a></span>
        {%- endif -%}
      </div>
    </div>

    <div class="snp-toast" role="status" aria-live="polite"><i aria-hidden="true"></i><span>{{ section.settings.toast | escape }}</span><small></small></div>
  </div>

  {%- if board_count > 0 -%}
  <div class="snp-sheet" role="dialog" aria-modal="true" aria-labelledby="snp-sh-{{ section.id }}" hidden>
    <button type="button" class="snp-sheet-scrim" aria-label="Close" tabindex="-1"></button>
    <form class="snp-sheet-box" novalidate>
      <div class="snp-sheet-hd">
        <h3 id="snp-sh-{{ section.id }}">Personalise your item</h3>
        <button type="button" class="snp-sheet-x" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </div>
      <p class="snp-sheet-sub">Tell us how to make it yours. We'll add these details to your order.</p>
      {%- for block in section.blocks -%}
        {%- if block.type == 'personalization_board' -%}
          {%- assign bt = block.settings.title | default: 'Personalisation' -%}
          <div class="snp-board" data-type="{{ block.settings.type }}" data-req="{{ block.settings.required }}" data-key="{{ bt | escape }}" {{ block.shopify_attributes }}>
            <div class="snp-board-t"><span>{{ bt | escape }}</span>{% if block.settings.required %}<em>Required</em>{% endif %}</div>
            {%- case block.settings.type -%}
              {%- when 'photo' -%}
                <label class="snp-board-l" for="snp-f-{{ block.id }}">{{ block.settings.field_label | default: 'Your photo' | escape }}</label>
                <div class="snp-drop">
                  <input type="file" id="snp-f-{{ block.id }}" accept="image/*">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h3l2-2.5h6L17 7h3v12H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
                  <div><b class="snp-drop-t">Tap to upload your photo</b><span>JPG or PNG, up to 10MB</span></div>
                  <img alt="" hidden>
                </div>
              {%- when 'message' -%}
                <label class="snp-board-l" for="snp-f-{{ block.id }}">{{ block.settings.field_label | default: 'Your message' | escape }}</label>
                <textarea class="snp-field" id="snp-f-{{ block.id }}" maxlength="500" placeholder="{{ block.settings.field_placeholder | default: 'Write your message here...' | escape }}"></textarea>
                <div class="snp-count-c"><span>0</span>/500</div>
              {%- else -%}
                <label class="snp-board-l" for="snp-f-{{ block.id }}">{{ block.settings.field_label | default: 'Your name' | escape }}</label>
                <input class="snp-field" type="text" id="snp-f-{{ block.id }}" maxlength="100" autocomplete="off" placeholder="{{ block.settings.field_placeholder | default: 'Enter here...' | escape }}">
            {%- endcase -%}
            {%- if block.settings.hint != blank -%}<div class="snp-board-h">{{ block.settings.hint | escape }}</div>{%- endif -%}
            <div class="snp-board-e">{% if block.settings.type == 'photo' %}Please add a photo.{% else %}Please fill this in.{% endif %}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
      <button type="submit" class="snp-sheet-go">ADD TO CART</button>
    </form>
  </div>
  {%- endif -%}

  <div class="snp-viewer" role="dialog" aria-modal="true" aria-label="{{ p.title | escape }} photos" hidden>
    <button type="button" class="snp-scrim" aria-label="Close photos" tabindex="-1"></button>
    <div class="snp-box">
      <div class="snp-vbar">
        <strong></strong><span></span>
        <button type="button" class="snp-vbtn snp-close" aria-label="Close photos"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </div>
      <div class="snp-frame" data-zoom="false">
        <span class="snp-view" role="img"></span>
        <button type="button" class="snp-vbtn snp-nav-l" aria-label="Previous photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
        <button type="button" class="snp-vbtn snp-nav-r" aria-label="Next photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
      </div>
      <div class="snp-rail"></div>
    </div>
  </div>

  <script type="application/json" class="snp-data">
    {
      "options": {{ p.options | json }},
      "variants": [
        {%- for v in p.variants -%}
          {
            "id": {{ v.id }},
            "options": {{ v.options | json }},
            "price": {{ v.price }},
            "compare": {{ v.compare_at_price | default: 0 }},
            "sku": {{ v.sku | json }},
            "available": {{ v.available | json }},
