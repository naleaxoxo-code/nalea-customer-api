      var s = document.createElement("span"); s.className = "snp-view"; viewStyle(s, x); b.appendChild(s);
      b.addEventListener("click", function () { vZoom = false; setViewer(i); }); rail.appendChild(b);
    });
  }
  function setViewer(i) {
