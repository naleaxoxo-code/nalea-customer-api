{% schema %}
{
  "name": "Sneaker product hero",
  "tag": "div",
  "class": "section-sneaker-product-hero",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (only used outside product pages)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "info": "Leave empty to use the product type" },
    { "type": "range", "id": "desc_words", "label": "Description length (words)", "min": 10, "max": 80, "step": 2, "default": 30 },
    { "type": "textarea", "id": "colours", "label": "Colour swatches", "info": "One per line: Colour name = swatch | backdrop tint", "default": "Gold = #d4af37 | #e8c46a\nSilver = #c0c0c8 | #9fb4d8\nRose gold = #e0a899 | #f2a7a0\nWhite = #f4f4f4 | #ff9f6e\nBlack = #1d1d1f | #7fd8bd" },
    { "type": "color", "id": "default_tint", "label": "Fallback backdrop tint", "default": "#ff9f6e" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show reviews row", "default": true },
    { "type": "text", "id": "rating", "label": "Fallback rating (if no review app)", "default": "4.5" },
    { "type": "text", "id": "reviews", "label": "Fallback review count", "default": "120" },
    { "type": "range", "id": "low_stock", "label": "Show 'Only N left' at or below", "min": 1, "max": 20, "step": 1, "default": 3 },
    { "type": "text", "id": "pay_line", "label": "Secure checkout line", "default": "Secure Payments via Yoco" },
    { "type": "text", "id": "pay_tip", "label": "Secure checkout bubble", "default": "Your payment goes through Yoco's encrypted checkout. Your card details never touch our site." },
    { "type": "checkbox", "id": "show_returns", "label": "Show returns line", "default": true },
    { "type": "range", "id": "return_days", "label": "Return window (days)", "min": 7, "max": 60, "step": 1, "default": 30, "info": "Must match your refund policy. Tag a product 'non-returnable' or 'returnable' to override the automatic check." },
    { "type": "text", "id": "toast", "label": "Add to cart message", "default": "Shopping Cart Updated" },
    { "type": "color", "id": "like_color", "label": "Heart colour", "default": "#e11d48" },
    { "type": "color", "id": "foreground", "label": "Text colour", "default": "#ffffff" },
    { "type": "color", "id": "background", "label": "Background colour", "default": "#1a1310" },
    { "type": "color", "id": "muted", "label": "Muted text colour", "default": "#d4c4b8" },
    { "type": "text", "id": "height", "label": "Minimum height", "default": "100svh" }
  ],
  "blocks": [
    {
      "type": "personalization_board",
      "name": "Personalisation field",
