    $(".snp-rtip-text").textContent = RT[k][1];
    retBtn.dataset.tone = k === "ok" ? "ok" : "no";
  }
  var tips = [];
  Array.prototype.forEach.call(root.querySelectorAll(".snp-trust-btn"), function (btn) {
    var tip = document.getElementById(btn.getAttribute("aria-describedby")), t = { on: false, timer: 0 };
    if (!tip) return;
    gsap.set(tip, { autoAlpha: 0 });
    var place = function () { tip.style.bottom = "auto"; tip.style.top = (btn.offsetTop - tip.offsetHeight - 8) + "px"; };
    t.show = function (on) {
      if (on === t.on) return; t.on = on; clearTimeout(t.timer);
      if (on) { tips.forEach(function (o) { if (o !== t) o.show(false); }); place(); gsap.fromTo(tip, { autoAlpha: 0, y: 6, scale: 0.96 }, { autoAlpha: 1, y: 0, scale: 1, duration: reduced() ? 0 : 0.3, ease: "back.out(2)" }); tip.style.pointerEvents = "auto"; }
      else { gsap.to(tip, { autoAlpha: 0, y: 4, duration: reduced() ? 0 : 0.18, ease: "power2.in" }); tip.style.pointerEvents = "none"; }
    };
    var leaveT;
    btn.addEventListener("pointerenter", function (e) { if (e.pointerType !== "touch") { clearTimeout(leaveT); t.show(true); } });
    btn.addEventListener("pointerleave", function (e) { if (e.pointerType !== "touch") leaveT = setTimeout(function () { t.show(false); }, 250); });
    tip.addEventListener("pointerenter", function () { clearTimeout(leaveT); });
    tip.addEventListener("pointerleave", function (e) { if (e.pointerType !== "touch") leaveT = setTimeout(function () { t.show(false); }, 250); });
