  var skuIc = $(".snp-sku-ic"), COPY = skuIc.innerHTML, TICK = '<path d="M4 10.5l4 4 8-9"/>', skuTimer;
  function copySku() {
    var el = $(".snp-sku"), code = el.dataset.sku; if (!code) return;
    var done = function () {
      el.dataset.copied = "true"; skuIc.innerHTML = TICK; $(".snp-sku-live").textContent = "SKU copied";
      clearTimeout(skuTimer); skuTimer = setTimeout(function () { el.dataset.copied = "false"; skuIc.innerHTML = COPY; $(".snp-sku-live").textContent = ""; }, 1500);
    };
