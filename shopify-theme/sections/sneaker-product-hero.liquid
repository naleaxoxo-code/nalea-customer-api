  function shareData() {
    var v = variantFor(active, size) || startV;
    var url = ORIGIN + "/products/" + HANDLE + (D.variants.length > 1 ? "?variant=" + v.id : "");
    var opts = [variants[active].name, size ? "size " + size : ""].filter(Boolean).join(", ");
    var head = "Look what I found at " + SHOP;
    var msg = head + " " + String.fromCodePoint(0x2728) + "\n" + title + (opts ? " (" + opts + ")" : "") + " - " + fmt(v.price / 100) + "\n" + url;
    return { url: url, head: head, msg: msg };
  }
  var shareBtn = $(".snp-share"), menu = $(".snp-menu"), menuOpen = false;
  function closeMenu(focus) {
