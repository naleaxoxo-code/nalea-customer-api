    ["", "X", IC.x, function (d) { window.open("https://twitter.com/intent/tweet?text=" + encodeURIComponent(d.head) + "&url=" + encodeURIComponent(d.url), "_blank", "noopener"); }],
    ["", "Email", IC.em, function (d) { location.href = "mailto:?subject=" + encodeURIComponent(d.head) + "&body=" + encodeURIComponent(d.msg); }]
