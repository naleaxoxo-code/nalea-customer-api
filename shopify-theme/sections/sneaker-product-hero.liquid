    x:'<path d="M4 3h4.4l4 5.6L17 3h3l-6.2 7.6L20.5 21H16l-4.3-6-5 6H3.6l6.7-8.1L4 3z" fill="currentColor"/>',
    em:'<path d="M3 6h18v12H3z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>'
