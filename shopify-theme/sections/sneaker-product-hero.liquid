  };
  var IC_RET = '<path d="M4 12a8 8 0 1 0 2.3-5.7"/><path d="M4 4v4h4"/>';
  var IC_SEAL = '<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>';
  var IC_HEART = '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>';
  var IC_TAG = '<path d="M3 12V4h8l9 9-8 8z"/><circle cx="7.5" cy="7.5" r="1.3"/>';
  var retBtn = $(".snp-ret");
  function renderReturns() {
