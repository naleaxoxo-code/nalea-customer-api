  }
  function closeViewer() { viewer = null; vZoom = false; viewerEl.hidden = true; if (opener) opener.focus(); }
  function step(d) { vZoom = false; var n = views().length; setViewer((viewer + d + n) % n); }
  $(".snp-scrim", viewerEl).addEventListener("click", closeViewer);
  $(".snp-close", viewerEl).addEventListener("click", closeViewer);
