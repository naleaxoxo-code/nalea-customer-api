  var items = [
    ["snp-wa", "WhatsApp", IC.wa, function (d) { window.open("https://wa.me/?text=" + encodeURIComponent(d.msg), "_blank", "noopener"); }],
    navigator.share ? ["", "More options", IC.go, function (d) { navigator.share({ title: d.head, text: d.msg, url: d.url }).catch(function () {}); }] : null,
    ["", "Copy message", IC.cp, function (d) {
