  items.forEach(function (it) {
    var b = document.createElement("button"); b.type = "button"; b.setAttribute("role", "menuitem"); if (it[0]) b.className = it[0];
    b.innerHTML = '<i><svg viewBox="0 0 24 24" aria-hidden="true">' + it[2] + "</svg></i>" + it[1];
