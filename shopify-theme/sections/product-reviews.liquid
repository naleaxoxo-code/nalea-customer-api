.tg-card{position:relative;grid-column:1;grid-row:1;margin:0;display:flex;min-width:0;flex-direction:column;overflow:hidden;border-radius:16px;border:1px solid var(--border);background:var(--card);color:var(--foreground);padding:14px 16px}
