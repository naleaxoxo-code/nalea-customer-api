.tg-root[data-roomy] .tg-fav{width:44px;height:44px}
.tg-who{min-width:0;flex:1}.tg-who b{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px;font-weight:600}
.tg-who span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;color:var(--muted-foreground)}
.tg-where{flex-shrink:0;text-align:right;font-size:12px;line-height:1.25;color:var(--muted-foreground)}
.tg-where span{display:block}.tg-where .tg-cc{margin-top:2px;font-family:ui-monospace,monospace;font-size:11px;text-transform:uppercase;letter-spacing:.05em}
.tg-nav{position:absolute;z-index:10;display:flex;align-items:center;gap:2px;right:12px;top:10px}
.tg-root[data-roomy] .tg-nav{right:16px;top:20px}
.tg-nb{display:grid;width:28px;height:28px;place-items:center;border-radius:999px!important;color:var(--muted-foreground)!important;transition:background .2s,color .2s}
.tg-nb:hover{background:var(--muted)!important;color:var(--foreground)!important}.tg-nb svg{width:16px;height:16px}
.tg-ct{min-width:48px;text-align:center;font-size:12px;font-variant-numeric:tabular-nums;color:var(--muted-foreground)}
.tg-leader{pointer-events:none;position:absolute;left:0;top:0;z-index:95;width:1px;height:1px;overflow:visible;color:var(--foreground)}
.tg-leader g{opacity:0;transition:opacity .2s}
.tg-empty{grid-column:1;grid-row:1;border-radius:16px;border:1px dashed var(--border);padding:24px;text-align:center;color:var(--muted-foreground);font-size:15px}
.tg-form{width:100%;max-width:28rem;margin:8px auto 32px;border-radius:16px;border:1px solid var(--border);background:var(--card);padding:20px;font-size:14px}
.tg-form h3{margin:0 0 4px;font-size:16px;font-weight:600;color:var(--foreground)}
.tg-form p{margin:0 0 12px;color:var(--muted-foreground)}
.tg-form label{display:block;margin:10px 0 4px;color:var(--muted-foreground);font-size:12px;text-transform:uppercase;letter-spacing:.1em}
.tg-form input,.tg-form textarea,.tg-form select{width:100%;border-radius:10px;border:1px solid var(--border);background:var(--background);color:var(--foreground);padding:10px 12px;font:inherit}
.tg-form textarea{min-height:90px;resize:vertical}
.tg-pick{display:flex;gap:4px}.tg-pick button{width:30px;height:30px}.tg-pick svg{width:26px;height:26px}
.tg-send{margin-top:14px;width:100%;height:42px;border-radius:999px!important;background:var(--primary)!important;color:var(--primary-foreground)!important;font-weight:600!important}
.tg-send:disabled{opacity:.5;cursor:not-allowed}
.tg-msg{margin-top:10px;min-height:1em;font-size:13px}
.tg-gate a{display:inline-flex;margin-top:4px;height:36px;align-items:center;border-radius:999px;background:var(--primary);color:var(--primary-foreground);padding:0 16px;font-weight:500;text-decoration:none}
@media (prefers-reduced-motion:reduce){.tg-root *{animation:none!important;transition:none!important}}
</style>

  <div class="tg-glow" aria-hidden="true"></div>
  <div class="tg-stage">
    <header class="tg-head">
      {%- if section.settings.eyebrow != blank -%}<p class="tg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="tg-h" id="tg-h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.caption != blank -%}<p class="tg-cap">{{ section.settings.caption | escape }}</p>{%- endif -%}
      <div class="tg-stats">
        <dl class="tg-dl">
          <div><dt class="tg-rl">reviews</dt><dd class="tg-rc">0</dd></div>
          <span class="tg-sep tg-avgsep" aria-hidden="true" hidden></span>
          <div class="tg-avgbox" hidden><dt>average</dt><dd><svg viewBox="0 0 20 20" aria-hidden="true" class="tg-on" width="14" height="14"><polygon class="tg-sp" fill="currentColor" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg><span class="tg-avg"></span></dd></div>
          <span class="tg-sep" aria-hidden="true"></span>
          <div><dt class="tg-cl">cities</dt><dd class="tg-cn">0</dd></div>
        </dl>
        <button type="button" class="tg-cta tg-write">Write a review<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h9.5M8.5 4l4 4-4 4"/></svg></button>
      </div>
    </header>

    <div class="tg-globe">
      <div class="tg-stars" aria-hidden="true"></div>
      <div class="tg-canvas" aria-hidden="true"></div>
      <div class="tg-pins"></div>
    </div>

    <div class="tg-cardwrap">
      <span class="tg-shadow" aria-hidden="true"></span>
      <div class="tg-region" aria-live="polite" aria-atomic="true">
        <div class="tg-empty">No reviews yet. Bought this? Be the first verified buyer to review it.</div>
      </div>
      <div class="tg-nav" hidden>
        <button type="button" class="tg-nb tg-prev" aria-label="Previous review"><svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3.5 5.5 8l4.5 4.5"/></svg></button>
        <span class="tg-ct"></span>
        <button type="button" class="tg-nb tg-next" aria-label="Next review"><svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3.5 10.5 8 6 12.5"/></svg></button>
      </div>
    </div>

    <svg class="tg-leader" aria-hidden="true" hidden><g><line x1="0" y1="0" x2="1" y2="0" stroke="currentColor" stroke-opacity=".38" stroke-width="1" vector-effect="non-scaling-stroke"/><circle class="tg-d0" r="2.5" fill="currentColor" fill-opacity=".6"/><circle class="tg-d1" r="3.5" fill="var(--background)" stroke="currentColor" stroke-opacity=".5" stroke-width="1.2"/></g></svg>
  </div>

  <div class="tg-form" id="tg-form-{{ section.id }}" hidden>
    {%- if customer == nil -%}
      <div class="tg-gate"><h3>Write a review</h3><p>Only verified buyers can review. Log in so we can check your order.</p><a href="/account/login?return_url={{ request.path | url_encode }}">Log in</a></div>
    {%- elsif has_ordered == false -%}
      <div class="tg-gate"><h3>Write a review</h3><p>Reviews are only open to customers who bought this product, so every review here is real.</p></div>
    {%- else -%}
      <h3>Write a review</h3>
      <p>✔ Verified buyer. Thanks for sharing your honest experience.</p>
      <label>Your rating</label>
      <div class="tg-pick" role="radiogroup" aria-label="Rating"></div>
      <label for="tg-ti-{{ section.id }}">Title (optional)</label>
      <input id="tg-ti-{{ section.id }}" class="tg-ti" maxlength="80">
      <label for="tg-bo-{{ section.id }}">Your review</label>
      <textarea id="tg-bo-{{ section.id }}" class="tg-bo" maxlength="600"></textarea>
      <label for="tg-ci-{{ section.id }}">Your city (shown on the globe)</label>
      <select id="tg-ci-{{ section.id }}" class="tg-ci"></select>
      <button type="button" class="tg-send">Submit review</button>
      <div class="tg-msg" role="status"></div>
    {%- endif -%}
  </div>

  <script type="application/json" class="tg-data">
    {
      "productId": {{ product.id | json }},
      "reviews": {% if rv %}{{ rv | json }}{% else %}[]{% endif %},
      "avatars": {% if avatars %}{{ avatars | json }}{% else %}{}{% endif %},
      "autoplay": {{ section.settings.autoplay | json }},
      "firebase": {{ section.settings.firebase | json }}
    }
  </script>
</section>

<script type="module">
import createGlobe from "https://cdn.jsdelivr.net/npm/cobe@0.6.3/+esm";
const root = document.getElementById("tg-{{ section.id }}");
const formEl = document.getElementById("tg-form-{{ section.id }}");
const D = JSON.parse(root.querySelector(".tg-data").textContent);
const $ = (s, el = root) => el.querySelector(s);

const CITIES = {
  "Johannesburg":[-26.20,28.05],"Pretoria":[-25.75,28.19],"Soweto":[-26.27,27.86],"Midrand":[-25.99,28.13],"Centurion":[-25.86,28.19],
  "Cape Town":[-33.93,18.42],"Stellenbosch":[-33.93,18.86],"Paarl":[-33.73,18.97],"George":[-33.96,22.46],
  "Durban":[-29.86,31.02],"Pietermaritzburg":[-29.60,30.38],"Richards Bay":[-28.78,32.04],"Newcastle":[-27.76,29.93],
  "Gqeberha":[-33.96,25.60],"East London":[-33.02,27.91],"Mthatha":[-31.59,28.78],
  "Bloemfontein":[-29.09,26.16],"Welkom":[-27.98,26.73],"Kimberley":[-28.73,24.76],"Upington":[-28.45,21.26],
  "Polokwane":[-23.90,29.45],"Mbombela":[-25.47,30.97],"Emalahleni":[-25.87,29.23],"Rustenburg":[-25.67,27.24],"Mahikeng":[-25.86,25.64],
  "Gaborone":[-24.63,25.92],"Windhoek":[-22.56,17.08],"Maseru":[-29.31,27.48],"Mbabane":[-26.31,31.14],"Maputo":[-25.97,32.57],"Harare":[-17.83,31.05]
};
const COUNTRY = { Gaborone:"BW", Windhoek:"NA", Maseru:"LS", Mbabane:"SZ", Maputo:"MZ", Harare:"ZW" };
const SA = [-29.0, 24.0];

const norm = (r, src) => ({
  name: (r.name || r.reviewer || "Customer").toString().slice(0, 60),
  rating: Math.max(0, Math.min(5, Math.round(Number(r.rating) || 0))),
  title: (r.title || "").toString(),
  quote: (r.body || r.review || "").toString(),
  city: r.city && CITIES[r.city] ? r.city : "",
  verified: src === "shopify" ? !!r.cid || !!r.verified : !!r.verifiedBuyer,
  date: r.date || (r.createdAt && r.createdAt.toDate ? r.createdAt.toDate().toLocaleDateString("en-ZA", { day: "numeric", month: "short", year: "numeric" }) : ""),
});
let reviews = (Array.isArray(D.reviews) ? D.reviews : []).map((r) => norm(r, "shopify"));
if (D.firebase) {
  try {
    const { initializeApp, getApps } = await import("https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js");
    const { getFirestore, collection, getDocs } = await import("https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js");
    const app = getApps().length ? getApps()[0] : initializeApp({ apiKey: "AIzaSyBgqMrjpdFiZhn1Qja6xsrJ9EKdF4XQxnI", authDomain: "naleaxoxo-reviews.firebaseapp.com", projectId: "naleaxoxo-reviews", storageBucket: "naleaxoxo-reviews.firebasestorage.app", messagingSenderId: "281354254840", appId: "1:281354254840:web:4c26ea64a7a099e1213e0d" });
    const snap = await getDocs(collection(getFirestore(app), "reviews_" + D.productId));
    const seen = new Set(reviews.map((r) => (r.name + "|" + r.quote).toLowerCase()));
    snap.forEach((doc) => { const r = norm(doc.data(), "firebase"); const k = (r.name + "|" + r.quote).toLowerCase(); if (r.quote && !seen.has(k)) { seen.add(k); reviews.push(r); } });
  } catch (e) { }
}
reviews = reviews.filter((r) => r.quote && r.rating >= 1);

const items = reviews.map((r, i) => {
  const [lat, lng] = r.city ? CITIES[r.city] : SA;
  const av = D.avatars && (D.avatars[r.name] || D.avatars[r.name.split(" ")[0]]);
  return { ...r, id: i, lat, lng, city: r.city || "South Africa", country: COUNTRY[r.city] || "ZA",
    image: av && /^(https?:|data:)/.test(av) ? av : "", emoji: av && !/^(https?:|data:)/.test(av) ? av : "", tone: (i % 5) + 1 };
});
items.sort((a, b) => b.lng - a.lng);

const pick = $(".tg-pick", formEl);
const STAR = Array.from({ length: 10 }, (_, k) => { const r = k % 2 ? 4.1 : 9.4, a = (k * Math.PI) / 5 - Math.PI / 2; return `${(10 + r * Math.cos(a)).toFixed(2)},${(10.6 + r * Math.sin(a)).toFixed(2)}`; }).join(" ");
const starSvg = (cls) => `<svg viewBox="0 0 20 20" aria-hidden="true" class="${cls}"><polygon points="${STAR}" fill="currentColor" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>`;
root.querySelectorAll(".tg-sp").forEach((p) => p.setAttribute("points", STAR));
$(".tg-write").addEventListener("click", () => { formEl.hidden = false; formEl.scrollIntoView({ behavior: "smooth", block: "center" }); });
if (pick) {
  let chosen = 0;
  const paint = (n) => pick.querySelectorAll("button").forEach((b, i) => { b.innerHTML = starSvg(i < n ? "tg-on" : "tg-off"); b.setAttribute("aria-checked", String(i + 1 === chosen)); });
  for (let i = 1; i <= 5; i++) {
    const b = document.createElement("button"); b.type = "button"; b.setAttribute("role", "radio"); b.setAttribute("aria-label", i + " star" + (i > 1 ? "s" : ""));
    b.addEventListener("mouseenter", () => paint(i)); b.addEventListener("mouseleave", () => paint(chosen)); b.addEventListener("click", () => { chosen = i; paint(i); });
    pick.appendChild(b);
  }
  paint(0);
  const sel = $(".tg-ci", formEl);
  sel.innerHTML = '<option value="">Prefer not to say</option>' + Object.keys(CITIES).map((c) => `<option>${c}</option>`).join("");
  $(".tg-send", formEl).addEventListener("click", async (e) => {
    const btn = e.currentTarget, msg = $(".tg-msg", formEl), body = $(".tg-bo", formEl).value.trim();
    if (!chosen) { msg.textContent = "Please choose a star rating."; return; }
    if (!body) { msg.textContent = "Please write a few words about your experience."; return; }
    btn.disabled = true; btn.textContent = "Submitting…"; msg.textContent = "";
    try {
      const res = await fetch("/apps/nalea/reviews" + location.search, { method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ product_id: D.productId, rating: chosen, title: $(".tg-ti", formEl).value.trim(), body, city: sel.value }) });
      const d = await res.json().catch(() => ({}));
      if (!res.ok || !d.success) throw new Error(d.error || "Could not submit your review.");
      msg.textContent = "✓ Thank you! Your review is live."; btn.textContent = "Submitted";
      setTimeout(() => location.reload(), 1500);
