    { "type": "text", "id": "caption", "label": "Caption", "default": "Every review comes from a customer whose order we've confirmed." },
    { "type": "checkbox", "id": "autoplay", "label": "Turn to each review automatically", "default": true },
    { "type": "checkbox", "id": "firebase", "label": "Include older reviews from the previous review system", "default": true },
    { "type": "checkbox", "id": "show_empty", "label": "Show the section when a product has no reviews yet", "default": true },
    { "type": "color", "id": "background", "label": "Background", "default": "#1a1310" },
    { "type": "color", "id": "card", "label": "Card", "default": "#241b16" },
    { "type": "color", "id": "foreground", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "muted", "label": "Muted text", "default": "#d4c4b8" }
  ],
  "presets": [{ "name": "Reviews globe" }]
}
