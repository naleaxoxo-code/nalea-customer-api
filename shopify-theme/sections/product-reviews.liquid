{%- comment -%}
  Testimonial Globe reviews. Liquid/vanilla-JS port of the 21st.dev "Testimonial Globe".
  Shows ONLY real customer reviews:
    - product.metafields.custom.reviews (written by the Nalea API after it checks the customer's orders)
    - the older Firebase reviews_<productId> collection (read only)
  New reviews are posted to /apps/nalea/reviews, which verifies the purchase on the server.
{%- endcomment -%}

{%- liquid
  assign rv = product.metafields.custom.reviews.value
  assign avatars = shop.metafields.custom.public_avatars.value
  assign has_ordered = false
  if customer
    for order in customer.orders
      for li in order.line_items
        if li.product_id == product.id
          assign has_ordered = true
        endif
      endfor
    endfor
  endif
-%}

<section id="tg-{{ section.id }}" class="tg-root" data-layout="stacked" aria-labelledby="tg-h-{{ section.id }}"
  style="--background:{{ section.settings.background }};--foreground:{{ section.settings.foreground }};--muted-foreground:{{ section.settings.muted }};--card:{{ section.settings.card }};--border:color-mix(in oklab,{{ section.settings.foreground }} 14%,transparent);--muted:color-mix(in oklab,{{ section.settings.foreground }} 8%,{{ section.settings.background }});--primary:{{ section.settings.foreground }};--primary-foreground:{{ section.settings.background }};--chart-1:#e8c46a;--chart-2:#f2a7a0;--chart-3:#7fd8bd;--chart-4:#f5b942;--chart-5:#9fb4d8;">
