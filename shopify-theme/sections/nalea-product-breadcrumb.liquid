{% comment %} NALEA product breadcrumb, restyled to match the product hero: same dark brown surface, muted labels, slash separators. Keeps the collection dropdown preview. {% endcomment %}

{% assign np_primary_collection = collection | default: product.collections.first %}

<div class="npc2" data-npc2>
  <style>.np-crumb{display:none!important}</style>
  <nav class="npc2__trail" aria-label="Breadcrumb">
    <a href="/" class="npc2__link">Home</a>
    {% if np_primary_collection %}
      <span class="npc2__sep" aria-hidden="true">/</span>
      <div class="npc2__wrap" data-npc2-wrap>
        <a href="{{ np_primary_collection.url }}" class="npc2__link" data-npc2-trigger aria-haspopup="true">{{ np_primary_collection.title }}<svg class="npc2__caret" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <div class="npc2__dropdown" data-npc2-panel>
          <p class="npc2__dd-label">More in {{ np_primary_collection.title }}</p>
          <div class="npc2__dd-grid">
            {% assign npc2_shown = 0 %}
            {% for p in np_primary_collection.products limit: 7 %}
              {% if p.id != product.id and npc2_shown < 6 %}
                {% assign npc2_shown = npc2_shown | plus: 1 %}
                <a href="{{ p.url }}" class="npc2__dd-item">
                  <span class="npc2__dd-img">{% if p.featured_image %}<img src="{{ p.featured_image | image_url: width: 150 }}" alt="" loading="lazy">{% endif %}</span>
                  <span class="npc2__dd-name">{{ p.title | truncate: 28 }}</span>
                </a>
              {% endif %}
            {% endfor %}
          </div>
          <a href="{{ np_primary_collection.url }}" class="npc2__dd-all">View all</a>
        </div>
      </div>
    {% endif %}
    <span class="npc2__sep" aria-hidden="true">/</span>
    <span class="npc2__current" aria-current="page">{{ product.title | truncate: 48 }}</span>
  </nav>
</div>

<style>
  .npc2{--npc2-bg:#1a1310;--npc2-fg:#ffffff;--npc2-muted:#d4c4b8;position:relative;z-index:5;margin-top:calc(var(--header-height,60px));background:color-mix(in oklab,var(--npc2-fg) 4%,var(--npc2-bg));color:var(--npc2-fg);container-type:inline-size;-webkit-font-smoothing:antialiased}
  .npc2__trail{display:flex;align-items:center;flex-wrap:wrap;gap:.6em;padding:max(18px,2.2cqw) 9cqw 0 7.3cqw;font-size:max(11px,.95cqw);letter-spacing:.12em;text-transform:uppercase;font-family:inherit}
  .npc2__link{display:inline-flex;align-items:center;gap:.35em;color:var(--npc2-muted);text-decoration:none;transition:color .2s}
  .npc2__link:hover,.npc2__wrap[data-open="true"] .npc2__link{color:var(--npc2-fg)}
  .npc2__sep{color:color-mix(in oklab,var(--npc2-muted) 45%,transparent)}
  .npc2__current{color:var(--npc2-fg);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:40cqw}
  .npc2__caret{width:.8em;height:.8em;transition:transform .25s}
  .npc2__wrap{position:relative}
  .npc2__wrap:hover .npc2__caret,.npc2__wrap[data-open="true"] .npc2__caret{transform:rotate(180deg)}
  .npc2__dropdown{position:absolute;top:calc(100% + 12px);left:0;z-index:20;width:min(360px,84vw);padding:14px;border-radius:14px;background:var(--npc2-bg);border:1px solid color-mix(in oklab,var(--npc2-fg) 14%,transparent);box-shadow:0 30px 80px -20px rgba(0,0,0,.5);text-transform:none;letter-spacing:normal;opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .25s,transform .25s cubic-bezier(.2,.8,.2,1),visibility .25s}
  .npc2__wrap:hover .npc2__dropdown,.npc2__wrap[data-open="true"] .npc2__dropdown{opacity:1;visibility:visible;transform:none}
  .npc2__dd-label{margin:0 0 10px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--npc2-muted)}
  .npc2__dd-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px}
  .npc2__dd-item{display:flex;flex-direction:column;gap:5px;text-decoration:none;color:var(--npc2-fg);transition:transform .2s}
  .npc2__dd-item:hover{transform:translateY(-2px)}
  .npc2__dd-img{display:block;aspect-ratio:1;border-radius:8px;overflow:hidden;background:color-mix(in oklab,var(--npc2-fg) 6%,var(--npc2-bg))}
  .npc2__dd-img img{width:100%;height:100%;object-fit:cover;display:block}
  .npc2__dd-name{font-size:11px;line-height:1.3;color:var(--npc2-muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .npc2__dd-all{display:block;padding-top:10px;border-top:1px solid color-mix(in oklab,var(--npc2-fg) 12%,transparent);text-align:center;font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--npc2-fg);text-decoration:none}
  @container (max-width:760px){.npc2__trail{padding:16px 20px 0}.npc2__current{max-width:52cqw}}
  @media (max-width:600px){.npc2__dropdown{left:50%;transform:translateX(-50%) translateY(-6px)}.npc2__wrap:hover .npc2__dropdown,.npc2__wrap[data-open="true"] .npc2__dropdown{transform:translateX(-50%)}}
  @media (prefers-reduced-motion:reduce){.npc2 *{transition:none!important}}
</style>

<script>
  (function () {
    var section = document.currentScript.closest('[data-npc2]') || document.querySelector('[data-npc2]');
    var wrap = section && section.querySelector('[data-npc2-wrap]');
    if (!wrap) return;
    var trigger = wrap.querySelector('[data-npc2-trigger]');
    trigger.addEventListener('click', function (e) {
      if (window.matchMedia('(hover: hover)').matches) return;
      e.preventDefault();
      var open = wrap.getAttribute('data-open') === 'true';
      wrap.setAttribute('data-open', open ? 'false' : 'true');
      trigger.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
    document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) wrap.setAttribute('data-open', 'false'); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') wrap.setAttribute('data-open', 'false'); });
  })();
</script>

{% schema %}
{
  "name": "Product Breadcrumb",
  "tag": "section",
  "class": "nalea-product-breadcrumb-section",
  "settings": [],
  "presets": [{ "name": "Product Breadcrumb" }]
}
{% endschema %}
